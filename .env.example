# Generate a production value with:
# venv/bin/python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,enpiro.local
DJANGO_TIME_ZONE=America/Toronto

# BME690 integration (not wired up yet)
BME690_I2C_ADDRESS=0x76

# Required before storing encrypted substrate Symbols.
# Generate with: python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
SUBSTRATE_ANCHOR=replace-me-with-base64
ROOT_KEY_ROTATION_SECONDS=2592000
