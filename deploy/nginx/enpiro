server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name piagara.local piagara;

    gzip off;

    location /static/ {
        alias /home/piagara/srv/enpiro/staticfiles/;
        access_log off;
        expires 1h;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Preserve TLS information supplied by the trusted Apache terminator.
        # Direct local HTTP requests omit this header and remain non-secure.
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 75s;
    }
}
